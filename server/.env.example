# Copy to .env (never commit .env). On the host, set these as environment variables instead.
DATABASE_URL=mysql://portfolio_app:CHANGE_ME@127.0.0.1:3306/portfolio
DB_SSL=false
SITE_URL=http://localhost:5173
ADMIN_TOKEN=
PORT=4000
# SITE_URL = your website origin(s), comma separated. DB_SSL=true if your MySQL host requires TLS.
# ADMIN_TOKEN: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
